---
// 首页与分区页共用的页面骨架：头部 / 分区导航 / 分面 chips / 卡片墙 / dev 编辑层。
// 页面只负责算出「这一页有哪些卡片、哪些轴」，markup 不重复写两遍。
import Base from '../layouts/Base.astro';
import { base, SITE_NAME } from '../lib/site';
import { THEMES } from '../lib/theme.mjs';
import {
  SECTIONS,
  hostOf,
  iconFor,
  statusOf,
  searchText,
  facetAttrs,
  badgeLabels,
  tagLabels,
  unreadCount,
  linkHref,
} from '../lib/links';
import type { Resource } from '../lib/links';

/** 卡片底部最多显示几个分类标签，超出的折成 +N（首页跨分区的卡片标签最容易溢出） */
const MAX_TAGS = 3;

export interface Chip {
  id: string;
  label: string;
  count: number;
  hint?: string;
}

export interface FacetRow {
  id: string;
  label: string;
  hint?: string;
  values: Chip[];
}

export interface NavItem {
  id: string;
  label: string;
  count: number;
  href: string;
  active: boolean;
}

interface Props {
  heading: string;
  meta: string;
  hint?: string;
  placeholder: string;
  nav: NavItem[];
  facetRows: FacetRow[];
  cards: Resource[];
  sectionId?: string;
}

const { heading, meta, hint = '', placeholder, nav, facetRows, cards, sectionId } = Astro.props;
const total = cards.length;

/** 「待看」是一个全局状态轴，与分区无关；没有条目就整行不要出 */
const unread = unreadCount(cards);
const rows = unread
  ? [...facetRows, { id: 'read', label: '状态', hint: '待看标记随资源一起发布', values: [{ id: 'unread', label: '待看', count: unread }] }]
  : facetRows;

/** 编辑层只在 dev 存在：markup 条件渲染，逻辑用动态 import，构建时整块被摇掉。
 *  data-facets 只有 dev 编辑层读，线上不输出。 */
const DEV = import.meta.env.DEV;
const title = heading === SITE_NAME ? SITE_NAME : `${heading} · ${SITE_NAME}`;
const description = `${heading}：${total} 条资源${hint ? `（${hint}）` : ''}，可搜索与按分类筛选。`;
const jsonHref = `${base}links.json`;
const rssHref = `${base}rss.xml`;
---

<Base title={title} description={description}>
  <header class="site-header">
  <div class="wrap header-inner">
    <div class="brand">
      <h1>{heading}</h1>
      <span class="meta">{meta}</span>
    </div>

    <div class="search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="M20 20l-3.5-3.5"></path>
      </svg>
      <input
        id="q"
        type="search"
        placeholder={placeholder}
        autocomplete="off"
        spellcheck="false"
        aria-label="搜索资源"
      />
      <kbd>/</kbd>
    </div>

    <div class="theme-picker">
      <button
        class="icon-btn"
        id="theme"
        type="button"
        title="切换配色"
        aria-label="切换配色"
        aria-expanded="false"
        aria-controls="theme-menu"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"></path>
        </svg>
      </button>
      <div class="theme-menu" id="theme-menu" hidden>
        {
          THEMES.map((theme) => (
            <button
              class="theme-opt"
              type="button"
              data-theme-value={theme.id}
              title={theme.label}
              aria-label={theme.label}
            >
              {theme.id === 'auto' ? (
                <span class="theme-tile theme-tile-auto">
                  <span class="theme-chip" data-theme="light" />
                  <span class="theme-chip" data-theme="dark" />
                  {theme.label}
                </span>
              ) : (
                <span class="theme-tile" data-theme={theme.id}>
                  {theme.label}
                </span>
              )}
            </button>
          ))
        }
      </div>
    </div>
  </div>
</header>

<div class="wrap catalog-layout">
  <aside class="sidebar" aria-label="资源浏览与筛选">
    <div class="sidebar-heading">浏览分区</div>
    <nav class="section-nav" aria-label="分区">
      {
        nav.map((item) => (
          <a
            class="section-link"
            class:list={{ 'is-active': item.active }}
            href={item.href}
            data-section={item.id}
            aria-current={item.active ? 'page' : undefined}
          >
            <span>{item.label}</span>
            <span class="n">{item.count}</span>
          </a>
        ))
      }
    </nav>

    {
      facetRows.length > 0 && (
        <div class="facets">
          <div class="sidebar-heading">筛选资源</div>
          {rows.map((row) => (
            <section class="facet-row" role="group" aria-label={`按${row.label}筛选`}>
              <div class="facet-heading">
                <span class="facet-name">{row.label}</span>
                {row.hint && <span class="facet-hint" title={row.hint}>可多选</span>}
              </div>
              <div class="facet-values">
                {row.values.map((v) => (
                  <button
                    class="chip"
                    type="button"
                    data-facet={row.id}
                    data-value={v.id}
                    aria-pressed="false"
                    title={v.hint ?? row.hint}
                  >
                    <span>{v.label}</span>
                    <span class="n">{v.count}</span>
                  </button>
                ))}
              </div>
            </section>
          ))}
        </div>
      )
    }
  </aside>

  <main>
    {hint && <p class="page-hint">{hint}</p>}
    <p id="recent" class="recent-note" hidden>
      <button id="recent-toggle" type="button">最近 7 天新增 <strong id="recent-count">0</strong> 条 · 只看这些</button>
    </p>
    <div class="toolbar">
    <span>显示 <strong id="shown">{total}</strong> / <span id="total">{total}</span> 条</span>
    <button id="copy" type="button" title="复制为 Markdown 列表" hidden>复制这 {total} 条</button>
    <span id="hint"></span>
    <button id="clear" type="button" hidden>清除筛选</button>
    <span id="copy-status" role="status"></span>
    <textarea id="copy-fallback" aria-label="手动复制 Markdown 清单" rows="4" spellcheck="false" readonly hidden></textarea>
  </div>

  {
    DEV && (
      <div id="dev" data-base={base} data-section={sectionId}>
        <span class="dev-tag">本地编辑</span>
        <button type="button" id="dev-add">＋ 新增资源</button>
        <button type="button" id="dev-batch">批量导入</button>
        <button type="button" id="dev-maintenance">链接维护</button>
        <button type="button" id="dev-publish">发布</button>
        <button type="button" id="dev-scan">查重</button>
        <button type="button" id="dev-import">导入书签文件</button>
        <a id="dev-capture" href="#" title="拖到书签栏：在任何页面点它，就把当前地址带回来收录">收录书签</a>
        <input id="dev-import-file" type="file" accept=".html,text/html" hidden />
        <span id="dev-state" role="status"></span>
        <span class="dev-hint">⌘K 命令</span>
      </div>
    )
  }

  <div class="grid" id="grid">
    {
      cards.map((l) => {
        const st = statusOf(l.url);
        const host = hostOf(l.url);
        const initial = (host.match(/[a-z0-9]/i)?.[0] ?? '·').toUpperCase();
        const icon = iconFor(host);
        // 只有确定失效（404/410、域名没了）才在卡片上报警；403、5xx、超时只是机器看不到，不吓人
        const linkBad = st?.status === 'fail';
        const badge = '链接可能失效';
        const attrs = facetAttrs(l, sectionId);
        // 首页一条资源会同时带多个分区的分类，不限数量会撑破卡片：只用前 3 个，其余折成「+N」
        const tags = tagLabels(l, sectionId);
        return (
          <div class="card-slot">
          <a
            class="card"
            href={l.url}
            target="_blank"
            rel="noopener noreferrer"
            {...attrs}
            data-section={l.section.join(' ')}
            data-search={searchText(l)}
            data-added={l.added}
            data-host={host}
            data-read={l.read === false ? '1' : ''}
            data-status={st?.status ?? ''}
            {...(DEV ? { 'data-facets': JSON.stringify(l.facets) } : {})}
          >
            <span class="card-top">
              <span class="fav">
                {icon ? (
                  <img src={`${base}${icon}`} alt="" loading="lazy" decoding="async" />
                ) : (
                  <span class="initial">{initial}</span>
                )}
              </span>
              <h2 data-hl>{l.title}</h2>
            </span>
            <p class="desc" data-hl>{l.desc}</p>
            <span class="card-bottom">
              <span class="type-badge">{badgeLabels(l, sectionId).join(' · ')}</span>
              <span class="mini-tags">
                {tags.slice(0, MAX_TAGS).map((t) => (
                  <span class="mini-tag">{t}</span>
                ))}
                {tags.length > MAX_TAGS && (
                  <span class="mini-tag more" title={tags.slice(MAX_TAGS).join('、')}>
                    +{tags.length - MAX_TAGS}
                  </span>
                )}
              </span>
              {l.read === false && <span class="badge-unread" title="标记为待看">待看</span>}
              {linkBad && (
                <span class="badge-fail" title={`最近检查：${st!.checked}`}>
                  {badge}
                </span>
              )}
            </span>
            <span class="host">{host}</span>
          </a>
          <a class="card-detail" href={linkHref(l)} title="详情">详情</a>
          </div>
        );
      })
    }
  </div>

  <p class="empty" id="empty" hidden>没有匹配的资源，试试别的关键词，或去掉一两项筛选。</p>

  <button class="to-top" id="to-top" type="button" aria-label="回到顶部" hidden>↑</button>

  <footer>
    <span>数据源：<a href="https://github.com/Su-luoya/resource-collector">Su-luoya/resource-collector</a> 的 Supabase 数据库（本站静态生成）</span>
    <span><a href={jsonHref}>links.json</a></span>
    <span><a href={rssHref}>RSS</a></span>
  </footer>
  </main>
</div>

{
  DEV && (
    <Fragment>
      <dialog id="dev-dialog" class="dev-dialog">
        <form id="dev-form">
          <h3 id="dev-heading">新增资源</h3>

          <label class="dev-field">
            <span>URL</span>
            <input
              id="f-url"
              type="text"
              inputmode="url"
              autocomplete="off"
              spellcheck="false"
              placeholder="https://… 或 docs.example.com"
            />
          </label>

          <div class="dev-fetch">
            <button type="button" id="f-fetch">自动抓取标题与简介</button>
            <span id="f-fetch-msg"></span>
          </div>
          <div class="dev-fetch">
            <button type="button" id="f-ai">AI 生成标题、简介与分类</button>
            <span id="f-ai-msg"></span>
          </div>
          <div id="f-ai-evidence" class="dev-ai-evidence" hidden></div>
          <div id="f-url-feedback" class="dev-url-feedback" hidden></div>

          <label class="dev-field">
            <span>标题 <em>≤80 字</em></span>
            <input id="f-title" maxlength="80" />
          </label>

          <label class="dev-field">
            <span>简介 <em>≤120 字</em></span>
            <textarea id="f-desc" rows="3" maxlength="120"></textarea>
          </label>

          <label class="dev-field">
            <span>收录日期</span>
            <input id="f-added" type="date" />
          </label>

          <label class="dev-check">
            <input id="f-read" type="checkbox" />
            <span>标记为「待看」（没看过、想稍后再读）</span>
          </label>

          <fieldset class="dev-sections">
            <legend>分区（可多选，决定进哪几页）</legend>
            {SECTIONS.map((s) => (
              <label>
                <input type="checkbox" value={s.id} data-section />
                {s.label}
              </label>
            ))}
          </fieldset>

          {SECTIONS.map((s) => (
            <div class="dev-panel" data-panel={s.id} hidden>
              <div class="dev-panel-title">{s.label}的分类</div>
              {s.facets.map((f) =>
                f.multi ? (
                  <fieldset class="dev-facet">
                    <legend>{f.label}（可多选）</legend>
                    {f.values.map((v) => (
                      <label>
                        <input type="checkbox" value={v.id} data-facet-id={f.id} />
                        {v.label}
                      </label>
                    ))}
                  </fieldset>
                ) : (
                  <label class="dev-field">
                    <span>{f.label}</span>
                    <select data-facet-id={f.id}>
                      <option value="">—</option>
                      {f.values.map((v) => (
                        <option value={v.id}>{v.label}</option>
                      ))}
                    </select>
                  </label>
                ),
              )}
            </div>
          ))}

          <p class="dev-err" id="f-err" hidden></p>

          <div class="dev-actions">
            <button type="button" class="del" id="f-delete" hidden>
              删除
            </button>
            <button type="button" class="del" id="f-batch-discard" hidden>放弃本批</button>
            <button type="button" id="f-cancel">取消</button>
            <button type="button" class="primary" id="f-save">保存</button>
          </div>
        </form>
      </dialog>
      <dialog id="dev-batch-dialog" class="dev-dialog">
        <section class="dev-batch">
          <h3>批量导入</h3>
          <p>每行一个 URL，每批最多 20 条。系统并发抓取标题和简介，已存在及本批重复的 URL 会跳过。</p>
          <p>草稿只保留在当前页面内存中；逐条确认分类后，整批才会一次写入。</p>
          <textarea id="dev-batch-urls" rows="8" spellcheck="false" placeholder="https://example.com/a&#10;https://example.com/b"></textarea>
          <div id="dev-batch-progress" class="dev-progress" hidden></div>
          <p id="dev-batch-msg" class="dev-maintenance-reason" role="status"></p>
          <div id="dev-batch-skipped" class="dev-batch-skipped"></div>
          <div class="dev-actions">
            <button type="button" id="dev-batch-cancel">关闭</button>
            <button type="button" class="primary" id="dev-batch-start">抓取草稿</button>
          </div>
        </section>
      </dialog>
      <dialog id="dev-publish-dialog" class="dev-dialog">
        <section class="dev-publish">
          <h3>确认发布</h3>
          <p id="dev-publish-summary" class="dev-publish-summary"></p>
          <div id="dev-publish-list" class="dev-publish-list"></div>
          <div id="dev-publish-progress" class="dev-progress" hidden></div>
          <p class="dev-err" id="dev-publish-err" hidden></p>
          <div class="dev-actions">
            <button type="button" id="dev-publish-cancel">取消</button>
            <button type="button" class="primary" id="dev-publish-confirm">确认发布</button>
          </div>
        </section>
      </dialog>
      <div id="dev-selectbar" class="dev-selectbar" hidden>
        <span id="dev-select-count">已选 0 条</span>
        <button type="button" id="dev-select-open">全部打开</button>
        <button type="button" class="del" id="dev-select-delete">批量删除</button>
        <button type="button" id="dev-select-clear">取消选择</button>
      </div>
      <div id="dev-toasts" class="dev-toasts" role="status" aria-live="polite"></div>
      <dialog id="dev-palette" class="dev-dialog dev-palette">
        <input
          id="dev-palette-input"
          type="text"
          placeholder="搜索命令…"
          autocomplete="off"
          spellcheck="false"
          aria-label="命令"
        />
        <ul id="dev-palette-list" class="dev-palette-list"></ul>
        <p class="dev-palette-hint">↑↓ 选择 · Enter 执行 · Esc 关闭</p>
      </dialog>
      <dialog id="dev-scan-dialog" class="dev-dialog">
        <section class="dev-scan">
          <div class="dev-maintenance-head">
            <div>
              <h3>全库查重</h3>
              <p>只报能确定的三类：URL 归一化后相同、去掉跟踪参数后相同、同站点且标题相同。</p>
            </div>
            <button type="button" id="dev-scan-close">关闭</button>
          </div>
          <div id="dev-scan-list" class="dev-scan-list"></div>
        </section>
      </dialog>
      <dialog id="dev-maintenance-dialog" class="dev-dialog">
        <section class="dev-maintenance">
          <div class="dev-maintenance-head">
            <div>
              <h3>链接维护</h3>
              <p>首次出现的失败和需要人工确认的重定向会列在这里；warn 仍只显示卡片角标。</p>
            </div>
            <button type="button" id="dev-maintenance-close">关闭</button>
          </div>
          <div id="dev-maintenance-list" class="dev-maintenance-list"></div>
        </section>
      </dialog>
      <dialog id="dev-import-dialog" class="dev-dialog">
        <section class="dev-scan">
          <div class="dev-maintenance-head">
            <div>
              <h3>导入书签</h3>
              <p id="dev-import-summary"></p>
            </div>
            <button type="button" id="dev-import-close">关闭</button>
          </div>
          <div id="dev-import-list" class="dev-scan-list"></div>
          <div class="dev-import-foot">
            <p id="dev-import-msg" class="dev-import-msg"></p>
            <button type="button" id="dev-import-commit" class="dev-primary">导入</button>
          </div>
        </section>
      </dialog>
    </Fragment>
  )
}

<script>
  import '../client/filter';
  import '../client/top';
</script>
</Base>

---
import '../styles/global.css';
import { base } from '../lib/site';
import { THEME_IDS } from '../lib/theme.mjs';

interface Props {
  title?: string;
  description?: string;
  /** og:type：首页与分区页是 website，资源详情页是 article */
  type?: string;
}
const {
  title = '资源库',
  description = '个人网络资源库：经济金融、Python、机器学习、论文写作与 AI 工具的链接索引。',
  type = 'website',
} = Astro.props;

/** 构建时 Astro.url 已经是「站点 + base + 路径」的绝对地址，分享卡片与 canonical 都用它 */
const canonical = Astro.url.href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="资源库" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="资源库 · 最近新增" href={`${base}rss.xml`} />
    <script is:inline define:vars={{ themeIds: THEME_IDS }}>
      // 在首帧之前定主题，避免闪白；localStorage 里是我删过的旧值就直接当没选。
      try {
        const saved = localStorage.getItem('theme');
        const prefersDark = matchMedia('(prefers-color-scheme: dark)').matches;
        const fallback = prefersDark ? 'dark' : 'light';
        document.documentElement.dataset.theme = themeIds.includes(saved) ? saved : fallback;
      } catch {
        /* noop */
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

---
// 分区页：/scholar/ /data/ /packages/ /nav/
// 路由由 taxonomy.json 的 sections 生成，加第 5 块只改 JSON，不用在这里加文件。
import type { GetStaticPaths } from 'astro';
import Catalog from '../components/Catalog.astro';
import {
  SECTIONS,
  SECTION_BY_ID,
  navItems,
  facetsFor,
  sectionLinks,
} from '../lib/links';

export const getStaticPaths = (() =>
  SECTIONS.map((section) => ({ params: { section: section.id }, props: { sectionId: section.id } }))) satisfies GetStaticPaths;

const { sectionId } = Astro.props as { sectionId: string };
const def = SECTION_BY_ID.get(sectionId);
if (!def) throw new Error(`taxonomy.json 里没有分区：${sectionId}`);

const rows = sectionLinks(sectionId);
---

<Catalog
  heading={def.label}
  meta={`${rows.length} 条 · 最近更新 ${rows[0]?.added ?? '—'}`}
  hint={def.hint}
  placeholder={`在「${def.label}」里搜索（多词用空格分隔）`}
  nav={navItems(sectionId)}
  facetRows={facetsFor(sectionId, rows)}
  cards={rows}
  sectionId={sectionId}
/>

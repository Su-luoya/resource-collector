---
import Catalog from '../components/Catalog.astro';
import { SECTIONS, navItems, sectionCount, unknownFacets, links, lastUpdated } from '../lib/links';

const bad = unknownFacets(links);
if (bad.length) {
  throw new Error(`links.yaml 里出现 taxonomy.json 未登记的取值：${bad.slice(0, 8).join('；')}`);
}

const facetRows = [
  {
    id: 'section',
    label: '分区',
    hint: '一条资源可以同时进几个分区',
    values: SECTIONS.map((s) => ({
      id: s.id,
      label: s.label,
      count: sectionCount(s.id),
      hint: s.hint,
    })),
  },
];
---

<Catalog
  heading="资源库"
  meta={`${links.length} 条 · ${SECTIONS.length} 个分区 · 最近更新 ${lastUpdated}`}
  placeholder="搜索标题、简介、分类、域名…"
  nav={navItems()}
  facetRows={facetRows}
  cards={links.map((link) => ({ link }))}
  total={links.length}
/>

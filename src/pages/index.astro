---
import Base from '../layouts/Base.astro';
import { links, allTags, hostOf, lastUpdated, statusOf, searchText, unknownTags, iconFor, TAG_LABEL } from '../lib/links';

const bad = unknownTags(links);
if (bad.length) {
  throw new Error(`links.yaml 里出现未登记的标签：${bad.join(', ')}（请在 src/lib/links.ts 的 TAGS 中登记）`);
}

/** Astro 的 BASE_URL 可能不带结尾斜杠，统一补齐，拼接资源路径才不会粘在一起 */
const raw = import.meta.env.BASE_URL;
const base = raw.endsWith('/') ? raw : `${raw}/`;
const total = links.length;
const jsonHref = `${base}links.json`;
const rssHref = `${base}rss.xml`;
---

<Base>
  <header class="site-header">
    <div class="wrap header-inner">
      <div class="brand">
        <h1>资源库</h1>
        <span class="meta">{total} 条 · {allTags.length} 个标签 · 最近更新 {lastUpdated}</span>
      </div>

      <div class="search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M20 20l-3.5-3.5"></path>
        </svg>
        <input
          id="q"
          type="search"
          placeholder="搜索标题、简介、标签、域名…"
          autocomplete="off"
          spellcheck="false"
          aria-label="搜索资源"
        />
        <kbd>/</kbd>
      </div>

      <button class="icon-btn" id="theme" type="button" title="切换深浅色" aria-label="切换深浅色">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"></path>
        </svg>
      </button>
    </div>

    <div class="wrap">
      <div class="tagbar" role="group" aria-label="按标签筛选">
        {
          allTags.map((t) => (
            <button class="chip" type="button" data-tag={t.id} aria-pressed="false" title={t.hint}>
              {t.label}
              <span class="n">{t.count}</span>
            </button>
          ))
        }
      </div>
    </div>
  </header>

  <main class="wrap">
    <div class="toolbar">
      <span>显示 <strong id="shown">{total}</strong> / {total} 条</span>
      <span id="hint"></span>
      <button class="clear-btn" id="clear" type="button" hidden>清除筛选</button>
    </div>

    <div class="grid" id="grid">
      {
        links.map((l) => {
          const st = statusOf(l.url);
          const host = hostOf(l.url);
          const initial = (host.match(/[a-z0-9]/i)?.[0] ?? '·').toUpperCase();
          const icon = iconFor(host);
          const bad = st && (st.status === 'fail' || st.status === 'warn');
          const badge = st?.status === 'fail' ? '链接可能失效' : '链接待确认';
          return (
            <a
              class="card"
              href={l.url}
              target="_blank"
              rel="noopener noreferrer"
              data-tags={l.tags.join(' ')}
              data-search={searchText(l)}
              data-added={l.added}
            >
              <span class="card-top">
                <span class="fav">
                  {icon ? (
                    <img src={`${base}${icon}`} alt="" loading="lazy" decoding="async" />
                  ) : (
                    <span class="initial">{initial}</span>
                  )}
                </span>
                <h2>{l.title}</h2>
              </span>
              <p class="desc">{l.desc}</p>
              <span class="card-bottom">
                <span class="host">{host}</span>
                {bad && (
                  <>
                    <span class="dot">·</span>
                    <span class={st!.status === 'fail' ? 'badge-fail' : 'badge-warn'} title={`最近检查：${st!.checked}`}>
                      {badge}
                    </span>
                  </>
                )}
                <span class="mini-tags">
                  {l.tags.map((t) => (
                    <span class="mini-tag">{TAG_LABEL.get(t) ?? t}</span>
                  ))}
                </span>
              </span>
            </a>
          );
        })
      }
    </div>

    <p class="empty" id="empty" hidden>没有匹配的资源，试试别的关键词。</p>

    <footer>
      <span>数据源：<a href="https://github.com/Su-luoya/resource-collector">Su-luoya/resource-collector</a> 仓库内的 <code>src/data/links.yaml</code></span>
      <span><a href={jsonHref}>links.json</a></span>
      <span><a href={rssHref}>RSS</a></span>
    </footer>
  </main>

  <script>
    type Chip = HTMLButtonElement & { dataset: DOMStringMap };
    const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>('.card'));
    const chips = Array.from(document.querySelectorAll<Chip>('.chip[data-tag]'));
    const qInput = document.getElementById('q') as HTMLInputElement;
    const shown = document.getElementById('shown') as HTMLElement;
    const hint = document.getElementById('hint') as HTMLElement;
    const clearBtn = document.getElementById('clear') as HTMLButtonElement;
    const empty = document.getElementById('empty') as HTMLElement;
    const themeBtn = document.getElementById('theme') as HTMLButtonElement;

    const selected = new Set<string>();
    let query = '';
    let activeIndex = -1;

    const visible = () => cards.filter((c) => !c.hidden);

    function apply() {
      const q = query.trim().toLowerCase();
      let n = 0;
      for (const card of cards) {
        const tags = (card.dataset.tags || '').split(' ');
        const okTags = [...selected].every((t) => tags.includes(t));
        const okQ = !q || (card.dataset.search || '').includes(q);
        const show = okTags && okQ;
        card.hidden = !show;
        if (show) n++;
      }
      shown.textContent = String(n);
      empty.hidden = n > 0;
      const filtering = selected.size > 0 || q !== '';
      clearBtn.hidden = !filtering;
      hint.textContent = selected.size > 1 ? '（标签取交集）' : '';

      for (const chip of chips) {
        chip.setAttribute('aria-pressed', selected.has(chip.dataset.tag!) ? 'true' : 'false');
      }

      const hash = new URLSearchParams();
      if (selected.size) hash.set('tags', [...selected].join(','));
      if (q) hash.set('q', query.trim());
      const frag = hash.toString();
      history.replaceState(null, '', frag ? `#${frag}` : location.pathname + location.search);

      activeIndex = -1;
      cards.forEach((c) => c.classList.remove('is-active'));
    }

    function readHash() {
      const p = new URLSearchParams(location.hash.slice(1));
      selected.clear();
      for (const t of (p.get('tags') || '').split(',').filter(Boolean)) selected.add(t);
      query = p.get('q') || '';
      qInput.value = query;
      apply();
    }

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const t = chip.dataset.tag!;
        selected.has(t) ? selected.delete(t) : selected.add(t);
        apply();
      });
    });

    qInput.addEventListener('input', () => {
      query = qInput.value;
      apply();
    });

    clearBtn.addEventListener('click', () => {
      selected.clear();
      query = '';
      qInput.value = '';
      apply();
    });

    window.addEventListener('hashchange', readHash);

    // ---- 键盘 ----
    function move(delta: number) {
      const list = visible();
      if (!list.length) return;
      activeIndex = (activeIndex + delta + list.length) % list.length;
      cards.forEach((c) => c.classList.remove('is-active'));
      const target = list[activeIndex];
      target.classList.add('is-active');
      target.scrollIntoView({ block: 'nearest' });
    }

    document.addEventListener('keydown', (e) => {
      const typing = e.target instanceof HTMLElement && /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName);
      if (e.key === '/' && !typing) {
        e.preventDefault();
        qInput.focus();
        qInput.select();
        return;
      }
      if (e.key === 'Escape') {
        if (typing) {
          qInput.blur();
        } else {
          selected.clear();
          query = '';
          qInput.value = '';
          apply();
        }
        return;
      }
      if (typing) return;
      if (e.key === 'ArrowDown' || e.key === 'j') {
        e.preventDefault();
        move(1);
      } else if (e.key === 'ArrowUp' || e.key === 'k') {
        e.preventDefault();
        move(-1);
      } else if (e.key === 'Enter' && activeIndex >= 0) {
        const list = visible();
        list[activeIndex]?.click();
      }
    });

    // ---- 主题 ----
    themeBtn.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('theme', next);
    });

    readHash();
  </script>
</Base>

---
import Catalog from '../components/Catalog.astro';
import { SECTIONS, navItems, sectionCount, links } from '../lib/links';
import { SITE_NAME } from '../lib/site';

const facetRows = [
  {
    id: 'section',
    label: '分区',
    hint: '一条资源可以同时进几个分区',
    values: SECTIONS.map((s) => ({
      id: s.id,
      label: s.label,
      count: sectionCount(s.id),
      hint: s.hint,
    })),
  },
];
---

<Catalog
  heading={SITE_NAME}
  meta={`${links.length} 条 · ${SECTIONS.length} 个分区 · 最近更新 ${links[0]?.added ?? '—'}`}
  placeholder="搜索标题、简介、分类、域名（多词用空格分隔）"
  nav={navItems()}
  facetRows={facetRows}
  cards={links}
/>

---
import Base from '../layouts/Base.astro';
import {
  links,
  typeFacets,
  topicFacets,
  hostOf,
  lastUpdated,
  statusOf,
  searchText,
  unknownFacets,
  iconFor,
  TYPE_LABEL,
  TOPIC_LABEL,
  TYPES,
  TOPICS,
} from '../lib/links';

const bad = unknownFacets(links);
if (bad.types.length || bad.topics.length) {
  throw new Error(
    `links.yaml 里出现 taxonomy.json 未登记的取值：type=${bad.types.join(', ') || '无'}；topics=${bad.topics.join(', ') || '无'}`,
  );
}

/** Astro 的 BASE_URL 可能不带结尾斜杠，统一补齐，拼接资源路径才不会粘在一起 */
const raw = import.meta.env.BASE_URL;
const base = raw.endsWith('/') ? raw : `${raw}/`;
const total = links.length;
const jsonHref = `${base}links.json`;
const rssHref = `${base}rss.xml`;
---

<Base>
  <header class="site-header">
    <div class="wrap header-inner">
      <div class="brand">
        <h1>资源库</h1>
        <span class="meta">
          {total} 条 · {TYPES.length} 类资源 · {TOPICS.length} 个主题 · 最近更新 {lastUpdated}
        </span>
      </div>

      <div class="search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M20 20l-3.5-3.5"></path>
        </svg>
        <input
          id="q"
          type="search"
          placeholder="搜索标题、简介、类型、主题、域名…"
          autocomplete="off"
          spellcheck="false"
          aria-label="搜索资源"
        />
        <kbd>/</kbd>
      </div>

      <button class="icon-btn" id="theme" type="button" title="切换深浅色" aria-label="切换深浅色">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"></path>
        </svg>
      </button>
    </div>

    <div class="wrap facets">
      <div class="facet-row" role="group" aria-label="按资源类型筛选">
        <span class="facet-name">类型</span>
        {
          typeFacets.map((t) => (
            <button class="chip" type="button" data-facet="type" data-value={t.id} aria-pressed="false" title={t.hint}>
              {t.label}
              <span class="n">{t.count}</span>
            </button>
          ))
        }
      </div>

      <div class="facet-row" role="group" aria-label="按主题筛选">
        <span class="facet-name">主题</span>
        {
          topicFacets.map((t) => (
            <button class="chip" type="button" data-facet="topic" data-value={t.id} aria-pressed="false" title={t.hint}>
              {t.label}
              <span class="n">{t.count}</span>
            </button>
          ))
        }
      </div>
    </div>
  </header>

  <main class="wrap">
    <div class="toolbar">
      <span>显示 <strong id="shown">{total}</strong> / {total} 条</span>
      <span id="hint"></span>
      <button class="clear-btn" id="clear" type="button" hidden>清除筛选</button>
    </div>

    <div class="grid" id="grid">
      {
        links.map((l) => {
          const st = statusOf(l.url);
          const host = hostOf(l.url);
          const initial = (host.match(/[a-z0-9]/i)?.[0] ?? '·').toUpperCase();
          const icon = iconFor(host);
          const linkBad = st && (st.status === 'fail' || st.status === 'warn');
          const badge = st?.status === 'fail' ? '链接可能失效' : '链接待确认';
          return (
            <a
              class="card"
              href={l.url}
              target="_blank"
              rel="noopener noreferrer"
              data-type={l.type}
              data-topics={l.topics.join(' ')}
              data-search={searchText(l)}
              data-added={l.added}
            >
              <span class="card-top">
                <span class="fav">
                  {icon ? (
                    <img src={`${base}${icon}`} alt="" loading="lazy" decoding="async" />
                  ) : (
                    <span class="initial">{initial}</span>
                  )}
                </span>
                <h2>{l.title}</h2>
              </span>
              <p class="desc">{l.desc}</p>
              <span class="card-bottom">
                <span class="type-badge">{TYPE_LABEL[l.type] ?? l.type}</span>
                <span class="mini-tags">
                  {l.topics.map((t) => (
                    <span class="mini-tag">{TOPIC_LABEL[t] ?? t}</span>
                  ))}
                </span>
                {linkBad && (
                  <span class={st!.status === 'fail' ? 'badge-fail' : 'badge-warn'} title={`最近检查：${st!.checked}`}>
                    {badge}
                  </span>
                )}
              </span>
              <span class="host">{host}</span>
            </a>
          );
        })
      }
    </div>

    <p class="empty" id="empty" hidden>没有匹配的资源，试试别的关键词，或去掉一两项筛选。</p>

    <footer>
      <span>数据源：<a href="https://github.com/Su-luoya/resource-collector">Su-luoya/resource-collector</a> 仓库内的 <code>src/data/links.yaml</code></span>
      <span><a href={jsonHref}>links.json</a></span>
      <span><a href={rssHref}>RSS</a></span>
    </footer>
  </main>

  <script>
    const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>('.card'));
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip[data-facet]'));
    const qInput = document.getElementById('q') as HTMLInputElement;
    const shown = document.getElementById('shown') as HTMLElement;
    const hint = document.getElementById('hint') as HTMLElement;
    const clearBtn = document.getElementById('clear') as HTMLButtonElement;
    const empty = document.getElementById('empty') as HTMLElement;
    const themeBtn = document.getElementById('theme') as HTMLButtonElement;

    /** 两条轴各一个集合：同轴内取并集（OR），跨轴取交集（AND） */
    const picked = { type: new Set<string>(), topic: new Set<string>() };
    let query = '';
    let activeIndex = -1;

    const visible = () => cards.filter((c) => !c.hidden);

    function apply() {
      const q = query.trim().toLowerCase();
      const { type: ts, topic: ks } = picked;
      let n = 0;
      for (const card of cards) {
        const okType = ts.size === 0 || ts.has(card.dataset.type || '');
        const topics = (card.dataset.topics || '').split(' ');
        const okTopic = ks.size === 0 || topics.some((t) => ks.has(t));
        const okQ = !q || (card.dataset.search || '').includes(q);
        const show = okType && okTopic && okQ;
        card.hidden = !show;
        if (show) n++;
      }

      shown.textContent = String(n);
      empty.hidden = n > 0;

      const filtering = ts.size + ks.size > 0 || q !== '';
      clearBtn.hidden = !filtering;

      const notes: string[] = [];
      if (ts.size > 1 || ks.size > 1) notes.push('同一行内取并集');
      if (ts.size > 0 && ks.size > 0) notes.push('类型与主题取交集');
      hint.textContent = notes.length ? `（${notes.join('，')}）` : '';

      for (const chip of chips) {
        const axis = chip.dataset.facet as 'type' | 'topic';
        chip.setAttribute('aria-pressed', picked[axis].has(chip.dataset.value!) ? 'true' : 'false');
      }

      const hash = new URLSearchParams();
      if (ts.size) hash.set('type', [...ts].join(','));
      if (ks.size) hash.set('topic', [...ks].join(','));
      if (q) hash.set('q', query.trim());
      const frag = hash.toString();
      history.replaceState(null, '', frag ? `#${frag}` : location.pathname + location.search);

      activeIndex = -1;
      cards.forEach((c) => c.classList.remove('is-active'));
    }

    function readHash() {
      const p = new URLSearchParams(location.hash.slice(1));
      picked.type = new Set((p.get('type') || '').split(',').filter(Boolean));
      picked.topic = new Set((p.get('topic') || '').split(',').filter(Boolean));
      query = p.get('q') || '';
      qInput.value = query;
      apply();
    }

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const axis = chip.dataset.facet as 'type' | 'topic';
        const value = chip.dataset.value!;
        picked[axis].has(value) ? picked[axis].delete(value) : picked[axis].add(value);
        apply();
      });
    });

    qInput.addEventListener('input', () => {
      query = qInput.value;
      apply();
    });

    function reset() {
      picked.type.clear();
      picked.topic.clear();
      query = '';
      qInput.value = '';
      apply();
    }

    clearBtn.addEventListener('click', reset);
    window.addEventListener('hashchange', readHash);

    // ---- 键盘 ----
    function move(delta: number) {
      const list = visible();
      if (!list.length) return;
      activeIndex = (activeIndex + delta + list.length) % list.length;
      cards.forEach((c) => c.classList.remove('is-active'));
      const target = list[activeIndex];
      target.classList.add('is-active');
      target.scrollIntoView({ block: 'nearest' });
    }

    document.addEventListener('keydown', (e) => {
      const typing = e.target instanceof HTMLElement && /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName);
      if (e.key === '/' && !typing) {
        e.preventDefault();
        qInput.focus();
        qInput.select();
        return;
      }
      if (e.key === 'Escape') {
        if (typing) qInput.blur();
        else reset();
        return;
      }
      if (typing) return;
      if (e.key === 'ArrowDown' || e.key === 'j') {
        e.preventDefault();
        move(1);
      } else if (e.key === 'ArrowUp' || e.key === 'k') {
        e.preventDefault();
        move(-1);
      } else if (e.key === 'Enter' && activeIndex >= 0) {
        visible()[activeIndex]?.click();
      }
    });

    // ---- 主题 ----
    themeBtn.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('theme', next);
    });

    readHash();
  </script>
</Base>
